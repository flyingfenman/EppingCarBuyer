{
  "$schema": "node_modules/wrangler/config-schema.json",
  // Must match the Worker's name in the Cloudflare dashboard, or Cloudflare's build fails.
  "name": "eppingcarbuyer",
  "main": ".open-next/worker.js",
  "compatibility_date": "2025-06-01",
  "compatibility_flags": ["nodejs_compat", "global_fetch_strictly_public"],
  "assets": {
    "directory": ".open-next/assets",
    "binding": "ASSETS"
  },
  "services": [
    {
      "binding": "WORKER_SELF_REFERENCE",
      "service": "eppingcarbuyer"
    }
  ],
  // Car and valuation photos. Create this bucket once in the Cloudflare dashboard (R2 > Create bucket).
  "r2_buckets": [
    {
      "binding": "PHOTOS",
      "bucket_name": "epping-car-buyer-photos"
    }
  ],
  // Keep variables added in the Cloudflare dashboard when Cloudflare deploys (otherwise each deploy wipes them).
  "keep_vars": true,
  "observability": {
    "enabled": true
  }
}
