# Cloudflare Workers static assets: long browser caching, as Vercel did automatically.
# /_next/static files are renamed whenever their content changes, so they can be cached for a year.
/_next/static/*
  Cache-Control: public, max-age=31536000, immutable

# Fonts and images keep the same file name when replaced, so cache them for a shorter, safer time
# (7 days). If an image is swapped for a new one with the same name, visitors see the new one within a week.
/fonts/*
  Cache-Control: public, max-age=604800
/images/*
  Cache-Control: public, max-age=604800
/henry.webp
  Cache-Control: public, max-age=604800
/henry.png
  Cache-Control: public, max-age=604800
/favicon.ico
  Cache-Control: public, max-age=604800
/apple-touch-icon.png
  Cache-Control: public, max-age=604800
/icon.svg
  Cache-Control: public, max-age=604800
